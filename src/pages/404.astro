---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ページが見つかりません | Dodo Works">
  <main class="section-shell" style="padding-block: 12rem;">
    <p class="eyebrow">404 / NOT FOUND</p>
    <h1>ページが<br /><em>見つかりません。</em></h1>
    <p style="color: var(--muted); margin-block: 2rem;">お探しのページは移動したか、存在しないようです。</p>
    <a class="button button--primary" href="/">トップへ戻る <span aria-hidden="true">↗</span></a>
  </main>
</Layout>
